<Window x:Class="AnderFlowPrismIsland.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Ander Flow Prism Island" Width="232" Height="48"
 Background="Transparent" WindowStyle="None" AllowsTransparency="True"
 Topmost="True" ResizeMode="NoResize" ShowInTaskbar="False"
 SnapsToDevicePixels="True"
 Loaded="AoCarregar" Closing="AoFechar"
 MouseEnter="AoEntrar" MouseLeave="AoSair"
 PreviewKeyDown="AoPressionarTecla">
 <Border x:Name="BordaPrincipal" CornerRadius="23" Background="#0A0A0F"
         BorderBrush="#585048" BorderThickness="1" SnapsToDevicePixels="True">
  <StackPanel>
   <Grid Height="45" MouseLeftButtonUp="AoClicarCabecalho" Cursor="Hand"
         ToolTip="Clique para abrir ou recolher. Ctrl+Shift+Espaço também funciona.">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="46"/>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Canvas Width="24" Height="24" Margin="11,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
     <Ellipse Width="21" Height="21" Stroke="#E8622A" StrokeThickness="2"/>
     <Ellipse Width="7" Height="7" Fill="#E8622A" Canvas.Left="7" Canvas.Top="7"/>
    </Canvas>
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
     <TextBlock x:Name="TituloPrincipal" FontWeight="Bold" FontFamily="Segoe UI"
                FontSize="11" Foreground="#F5F5F0" Text="PRISM ISLAND"/>
     <TextBlock x:Name="StatusCompacto" FontSize="10" Foreground="#AAA49E"
                Text="Ander Flow" />
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
     <StackPanel x:Name="MiniBarras" Orientation="Horizontal" VerticalAlignment="Center"
                 Margin="0,0,8,0" Visibility="Collapsed">
      <Rectangle x:Name="MiniBarra1" Width="3" Height="5" RadiusX="1.5" RadiusY="1.5" Fill="#E8622A" Margin="1,0" VerticalAlignment="Center"/>
      <Rectangle x:Name="MiniBarra2" Width="3" Height="10" RadiusX="1.5" RadiusY="1.5" Fill="#E8622A" Margin="1,0" VerticalAlignment="Center"/>
      <Rectangle x:Name="MiniBarra3" Width="3" Height="7" RadiusX="1.5" RadiusY="1.5" Fill="#E8622A" Margin="1,0" VerticalAlignment="Center"/>
     </StackPanel>
     <TextBlock x:Name="MiniTempo" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                Foreground="#E8622A" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
     <TextBlock x:Name="IndicadorAbertura" Text="⌄" Foreground="#E8622A" FontSize="20"
                VerticalAlignment="Center" HorizontalAlignment="Center" Width="22" TextAlignment="Center"/>
    </StackPanel>
   </Grid>
   <Border x:Name="PainelAberto" Visibility="Collapsed" Padding="14,0,14,14">
    <StackPanel>
     <Border Height="1" Margin="2,1,2,12" Background="#383239"/>
     <Grid Margin="5,0,5,10">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock x:Name="TextoTituloPainel" Text="Um espaço para o que importa." Foreground="#F5F5F0"
                  FontSize="16" FontWeight="SemiBold"/>
       <TextBlock x:Name="TextoSubtitulo" Text="Rápido, discreto e sempre por perto."
                  FontSize="11" Foreground="#98949A" Margin="0,4,0,0"/>
      </StackPanel>
      <Button Grid.Column="1" x:Name="BotaoFixar" Content="Fixar" Style="{StaticResource Acao}"
              Click="AoFixar" ToolTip="Manter o painel aberto"/>
     </Grid>
     <UniformGrid Columns="7" Margin="0,0,0,8">
      <Button x:Name="AbaMidia" Content="Mídia" Style="{StaticResource AbaPrism}" Tag="{StaticResource IcMidia}" Click="AoSelecionarMidia"/>
      <Button x:Name="AbaFoco" Content="Foco" Style="{StaticResource AbaPrism}" Tag="{StaticResource IcFoco}" Click="AoSelecionarFoco"/>
      <Button x:Name="AbaAlertas" Content="Alertas" Style="{StaticResource AbaPrism}" Tag="{StaticResource IcAlertas}" Click="AoSelecionarAlertas"/>
      <Button x:Name="AbaDesktop" Content="Desktop" Style="{StaticResource AbaPrism}" Tag="{StaticResource IcDesktop}" Click="AoSelecionarDesktop"/>
      <Button x:Name="AbaSistema" Content="Sistema" Style="{StaticResource AbaPrism}" Tag="{StaticResource IcSistema}" Click="AoSelecionarSistema"/>
      <Button x:Name="AbaAjustes" Content="Ajustes" Style="{StaticResource AbaPrism}" Tag="{StaticResource IcAjustes}" Click="AoSelecionarAjustes"/>
      <Button x:Name="AbaCopias" Content="Cópias" Style="{StaticResource AbaPrism}" Tag="{StaticResource IcCopias}" Click="AoSelecionarCopias"/>
     </UniformGrid>
     <Border x:Name="PainelMidia" Style="{StaticResource CartaoPrism}" Visibility="Collapsed">
      <StackPanel>
       <TextBlock Text="TOCANDO AGORA" Style="{StaticResource RotuloSecao}" Margin="2,0,0,9"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="42" Height="42" Background="#372522" CornerRadius="14" BorderBrush="#E8622A" BorderThickness="1">
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Rectangle x:Name="BarraMusica1" Height="8" Width="4" Fill="#E8622A" Margin="1,0"/>
          <Rectangle x:Name="BarraMusica2" Height="16" Width="4" Fill="#E8622A" Margin="1,0"/>
          <Rectangle x:Name="BarraMusica3" Height="11" Width="4" Fill="#E8622A" Margin="1,0"/>
         </StackPanel>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
         <TextBlock x:Name="TextoMusica" Text="Nenhuma mídia em reprodução" FontSize="14" FontWeight="SemiBold"
                    Foreground="#F5F5F0" TextTrimming="CharacterEllipsis" />
         <TextBlock x:Name="TextoArtista" Text="Abra Spotify, YouTube ou outro player compatível"
                    Foreground="#A59FA3" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,4,0,0"/>
         <TextBlock x:Name="TextoOrigem" Foreground="#E8622A" FontSize="10" Text=""/>
        </StackPanel>
       </Grid>
       <ProgressBar x:Name="ProgressoFaixa" Style="{StaticResource ProgressoPrism}" Minimum="0" Maximum="100" Value="0" Margin="3,14,3,7"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock x:Name="TextoPosicao" Text="--:--" FontSize="10" Foreground="#AAA49E"/>
        <TextBlock x:Name="TextoDuracao" Text="--:--" Grid.Column="1" HorizontalAlignment="Right" FontSize="10" Foreground="#AAA49E"/>
       </Grid>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,9">
        <Button x:Name="BotaoAnterior" Content="Anterior" ToolTip="Anterior" Style="{StaticResource IconeSolido}" Tag="{StaticResource IcAnterior}" Click="AoMidiaAnterior" IsEnabled="False"/>
        <Button x:Name="BotaoPlay" Content="Reproduzir" ToolTip="Reproduzir / pausar" Style="{StaticResource IconeSolido}" Background="#E8622A" Width="52" Height="52" Click="AoMidiaPlayPause" IsEnabled="False"/>
        <Button x:Name="BotaoProximo" Content="Próxima" ToolTip="Próxima" Style="{StaticResource IconeSolido}" Tag="{StaticResource IcProxima}" Click="AoMidiaProxima" IsEnabled="False"/>
       </StackPanel>
       <Grid Margin="3,0,3,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
        <Button x:Name="BotaoMudo" Content="Som" ToolTip="Silenciar" Style="{StaticResource IconeLinha}" Click="AoAlternarMudo"/>
        <Slider x:Name="SliderVolume" Style="{StaticResource SliderPrism}" Grid.Column="1" Minimum="0" Maximum="100" Value="50"
                VerticalAlignment="Center" TickFrequency="1" ValueChanged="AoAlterarVolume"/>
        <TextBlock x:Name="TextoVolume" Text="--%" Grid.Column="2" Foreground="#F5F5F0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
       </Grid>
       <Button x:Name="BotaoAudioReativo" Content="Ativar animação que reage ao áudio real"
               Style="{StaticResource Acao}" Click="AoAlternarAudioReativo"
               ToolTip="Captura local do áudio de saída. Não salva nem transmite."/>
       <TextBlock x:Name="TextoRetornoMidia" FontSize="10" Foreground="#A6A0A1" Margin="3,9,0,0"
                  Text="Aguardando uma sessão de mídia do Windows"/>
      </StackPanel>
     </Border>
     <Border x:Name="PainelAlertas" Style="{StaticResource CartaoPrism}" Visibility="Collapsed">
      <StackPanel>
       <TextBlock Text="NOTIFICAÇÕES" Style="{StaticResource RotuloSecao}"/>
       <ScrollViewer MaxHeight="135" Margin="0,8,0,7" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ListaAlertas">
         <TextBlock Text="Sem alertas do Prism Island" FontSize="11" Foreground="#A6A0A1"/>
        </StackPanel>
       </ScrollViewer>
       <Button Content="Pedir acesso às notificações do Windows" Click="AoSolicitarNotificacoes"
               Style="{StaticResource Acao}"/>
       <TextBlock x:Name="TextoAcessoAlertas" Text="Notificações de outros aplicativos dependem de permissão e identidade do pacote."
                  FontSize="10" TextWrapping="Wrap" Foreground="#A6A0A1" Margin="5,7,5,0"/>
       <Button Content="Limpar meus alertas" Click="AoLimparAlertas" Style="{StaticResource Acao}"/>
      </StackPanel>
     </Border>
     <Border x:Name="PainelDesktop" Style="{StaticResource CartaoPrism}" Visibility="Collapsed">
      <ScrollViewer MaxHeight="325" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
       <StackPanel>
        <TextBlock Text="MOD REAL DO WINDOWS" Style="{StaticResource RotuloSecao}" Margin="2,0,0,7"/>
        <TextBlock Text="Muda configurações nativas da conta atual. Confirma antes, cria backup e permite restaurar." FontSize="11" TextWrapping="Wrap" Foreground="#B9B5B3" Margin="3,0,3,8"/>
        <UniformGrid Columns="2">
         <Button Content="Windows escuro" Click="AoWindowsEscuro" Style="{StaticResource Acao}"/>
         <Button Content="Windows claro" Click="AoWindowsClaro" Style="{StaticResource Acao}"/>
         <Button Content="Ícones à esquerda" Click="AoWindowsAlinharEsquerda" Style="{StaticResource Acao}"/>
         <Button Content="Ícones no centro" Click="AoWindowsAlinharCentro" Style="{StaticResource Acao}"/>
        </UniformGrid>
        <Button Content="Realçar contorno das janelas" Click="AoWindowsBordas" Style="{StaticResource Acao}"/>
        <Button Content="Restaurar aparência original do Windows" Click="AoWindowsRestaurar" Background="#542C28" Style="{StaticResource Acao}"/>
        <TextBlock Text="ESTILIZAÇÃO AVANÇADA DO EXPLORER" Style="{StaticResource RotuloSecao}" Margin="2,13,0,7"/>
        <Button Content="Tema Prism na barra original (Windhawk)" Click="AoModWindhawk" Background="#E8622A" Style="{StaticResource Acao}"/>
        <TextBlock Text="O Windhawk modifica componentes da barra real. É opcional, requer instalar o mod e importar o tema; não é uma sobreposição." FontSize="10" TextWrapping="Wrap" Foreground="#B9B5B3" Margin="5,6,5,8"/>
        <Button Content="Configurações oficiais da barra" Click="AoAbrirBarraWindows" Style="{StaticResource Acao}"/>
        <TextBlock Text="ITENS INDEPENDENTES" Style="{StaticResource RotuloSecao}" Margin="2,13,0,7"/>
        <Button x:Name="BotaoDock" Content="Ativar Dock Flow (adicional)" Click="AoAlternarDock" Style="{StaticResource Acao}"/>
        <Button Content="Escolher papel de parede" Click="AoEscolherWallpaper" Style="{StaticResource Acao}"/>
        <Button Content="Restaurar papel de parede anterior" Click="AoRestaurarWallpaper" Style="{StaticResource Acao}"/>
        <TextBlock x:Name="TextoDesktop" Text="Nenhuma alteração é feita sem confirmação. A restauração afeta somente mudanças gerenciadas pelo Prism."
                   FontSize="10" TextWrapping="Wrap" Foreground="#A6A0A1" Margin="5,8,5,0"/>
       </StackPanel>
      </ScrollViewer>
     </Border>
     <Border x:Name="PainelFoco" Style="{StaticResource CartaoPrism}" Visibility="Collapsed">
      <StackPanel>
       <TextBlock Text="SESSÃO DE FOCO" Style="{StaticResource RotuloSecao}"/>
       <TextBlock x:Name="TextoCronometro" Text="25:00" Foreground="#F5F5F0"
                  FontSize="42" FontWeight="SemiBold" FontFamily="Segoe UI" HorizontalAlignment="Center"
                  Margin="0,1,0,1"/>
       <TextBlock x:Name="TextoEstadoFoco" Text="Pronto para começar" Foreground="#A9A6A5"
                  FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,6"/>
       <UniformGrid Columns="2">
        <Button x:Name="BotaoTemporizador" Content="Iniciar" Style="{StaticResource Acao}"
                Background="#E8622A" Click="AoAlternarTemporizador"/>
        <Button Content="Reiniciar" Style="{StaticResource Acao}" Click="AoReiniciarTemporizador"/>
       </UniformGrid>
      </StackPanel>
     </Border>
     <Border x:Name="PainelSistema" Style="{StaticResource CartaoPrism}" Visibility="Collapsed">
      <StackPanel>
       <TextBlock Text="ESTADO DO WINDOWS" Style="{StaticResource RotuloSecao}"/>
       <TextBlock x:Name="TextoMonitor" Text="Monitor principal" Foreground="#F5F5F0" Margin="0,10,0,0" FontSize="13"/>
       <TextBlock x:Name="TextoMemoria" Text="Uso do aplicativo" Foreground="#B9B5B3" Margin="0,8,0,0" FontSize="12"/>
       <TextBlock x:Name="TextoUptime" Text="Atividade do sistema" Foreground="#B9B5B3" Margin="0,8,0,0" FontSize="12"/>
       <Button Content="Configurações de tela" Style="{StaticResource Acao}"
               Margin="0,12,0,0" Click="AoAbrirConfiguracoesWindows"/>
      </StackPanel>
     </Border>
     <Border x:Name="PainelCopias" Style="{StaticResource CartaoPrism}" Visibility="Collapsed">
      <StackPanel>
       <TextBlock Text="ÁREA DE TRANSFERÊNCIA" Style="{StaticResource RotuloSecao}"/>
       <ScrollViewer MaxHeight="150" Margin="0,8,0,7" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ListaCopias"/>
       </ScrollViewer>
       <Button x:Name="BotaoCopias" Content="Histórico de cópias: desligado" Click="AoAlternarCopias" Style="{StaticResource Acao}"/>
       <Button Content="Limpar histórico" Click="AoLimparCopias" Style="{StaticResource Acao}"/>
       <TextBlock Text="Guarda até 10 textos só na memória, nada vai para o disco e tudo some ao fechar. Começa desligado a cada abertura. Cópias que gerenciadores de senha marcam como sensíveis são ignoradas."
                  FontSize="10" TextWrapping="Wrap" Foreground="#A6A0A1" Margin="5,7,5,0"/>
      </StackPanel>
     </Border>
     <Border x:Name="PainelAjustes" Style="{StaticResource CartaoPrism}" Visibility="Collapsed">
      <StackPanel>
       <TextBlock Text="PERSONALIZAÇÃO" Foreground="#E8622A" FontSize="10" FontWeight="Bold"
                  Margin="5,3,0,8"/>
       <Button x:Name="BotaoTema" Content="Tema: Prism Flow" Style="{StaticResource Acao}"
               Click="AoAlternarTema"/>
       <Button x:Name="BotaoAutoInicio" Content="Iniciar com Windows: desligado"
               Style="{StaticResource Acao}" Click="AoAlternarAutoInicio"/>
       <Button x:Name="BotaoAutoOcultar" Content="Ocultar automaticamente: ligado"
               Style="{StaticResource Acao}" Click="AoAlternarAutoOcultar"
               ToolTip="Esconde a ilha do topo da tela. Ela volta ao encostar o mouse no topo, no centro."/>
       <Button x:Name="BotaoTempoOcultacao" Content="Tempo para ocultar: 2,5 s"
               Style="{StaticResource Acao}" Click="AoAlternarTempoOcultacao"
               ToolTip="Escolha entre 1,5 s, 2,5 s e 5 s para liberar o topo da tela."/>
       <Button x:Name="BotaoTelaCheia" Content="Ocultar em tela cheia: ligado"
               Style="{StaticResource Acao}" Click="AoAlternarTelaCheia"
               ToolTip="Some quando um jogo, vídeo ou apresentação ocupa a tela inteira."/>
       <TextBlock Text="Atalho global: Ctrl + Shift + Espaço  •  Mouse no topo central revela a ilha" Foreground="#B2ABA4"
                  Margin="6,9,0,3" FontSize="11"/>
      </StackPanel>
     </Border>
     <Grid Margin="6,12,4,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="TextoRodape" Text="Ander Flow • v0.4.0-dev" Foreground="#77717A"
                 FontSize="10" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="Recolher" Style="{StaticResource Acao}"
              Padding="10,6" Click="AoRecolher"/>
     </Grid>
    </StackPanel>
   </Border>
  </StackPanel>
 </Border>
</Window>